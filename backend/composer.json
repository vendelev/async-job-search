{
    "name": "vendelev/async-job-search",
    "description": "Учебный проект: асинхронный поиск вакансий",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "vendelev"
        }
    ],
    "require": {
        "amphp/amp": "^3.1.3",
        "sentry/sentry": "^4.30",
        "thesis/dic": "^0.5.3"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "phpat/phpat": "^0.12.4",
        "phpstan/phpstan": "^2.2.8",
        "phpstan/phpstan-phpunit": "^2.0.18",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "phpunit/phpunit": "^13.3.1",
        "rector/rector": "^2.6.3",
        "shipmonk/composer-dependency-analyser": "^1.8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "cache-dir": "./storage/temp/composer",
        "optimize-autoloader": true,
        "secure-http": false,
        "sort-packages": true
    },
    "scripts": {
        "fix": [
            "composer normalize --diff",
            "composer bump",
            "vendor/bin/rector process"
        ],
        "phpstan": "vendor/bin/phpstan --memory-limit=-1",
        "phpunit": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text",
        "phpunit-html-coverage": "php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-html storage/app/private/unit-coverage",
        "rector": "vendor/bin/rector process --dry-run",
        "test": [
            "composer normalize --diff --dry-run",
            "composer bump --dry-run",
            "composer validate",
            "composer rector",
            "composer phpstan",
            "php vendor/bin/composer-dependency-analyser",
            "composer phpunit"
        ]
    }
}
